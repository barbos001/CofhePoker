# ── Hardhat / deployment ─────────────────────────────────────────────
# Your deployer private key (with or without 0x prefix)
PRIVATE_KEY=0x_YOUR_DEPLOYER_PRIVATE_KEY

# Ethereum Sepolia RPC endpoint (public node or Alchemy/Infura)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ── Vite frontend (all must have VITE_ prefix) ───────────────────────
# Contract addresses — auto-filled by deploy scripts, or paste manually
VITE_CONTRACT_ADDRESS=0x_3CARD_POKER_CONTRACT
VITE_PVP_CONTRACT_ADDRESS=0x_3CARD_PVP_CONTRACT
VITE_HOLDEM_CONTRACT_ADDRESS=0x_HOLDEM_BOT_CONTRACT
VITE_HOLDEM_PVP_CONTRACT_ADDRESS=0x_HOLDEM_PVP_CONTRACT
VITE_VAULT_ADDRESS=0x_VAULT_CONTRACT

# Token addresses (Sepolia testnet)
VITE_USDT_ADDRESS=0x_USDT_TOKEN_ADDRESS

# Network configuration
VITE_CHAIN_ID=11155111
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ── Supabase (backend, leaderboard, chat, profiles) ──────────────────
# Create a project at https://supabase.com, then grab Project URL + anon key
# Run supabase/schema.sql in the Supabase SQL editor to create tables
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Optional ──────────────────────────────────────────────────────────
# Second private key for 2-player PvP testing
# PRIVATE_KEY_2=0x_SECOND_TEST_KEY

# Alchemy API key (improves RPC reliability)
# VITE_ALCHEMY_KEY=your_alchemy_key

# Override for development against local Hardhat node
# VITE_CHAIN_ID=31337
# VITE_SEPOLIA_RPC_URL=http://127.0.0.1:8545
